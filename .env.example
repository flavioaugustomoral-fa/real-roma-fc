# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: credenciais do projeto Supabase.
# Copie da tela do seu projeto em Supabase > Project Settings > API.
# São as duas variáveis que fazem o app salvar os dados em banco em vez de
# apenas no navegador. Sem elas, o app continua funcionando só com localStorage.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLICA"
